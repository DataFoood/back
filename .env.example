# ---------------------------------------------------------------------------
# DataFood — variáveis de ambiente
# Dev: copie para .env e rode `docker compose up -d --build`.
# Produção: veja docs/deploy.md (DEBUG=False exige SECRET_KEY e
# SHINZOU_SERVICE_TOKEN fortes, senão a aplicação se recusa a subir).
# ---------------------------------------------------------------------------
DEBUG=True

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-troque-em-producao
# Separados por ';'
ALLOWED_HOSTS=localhost;127.0.0.1;web

# Origens do frontend (separadas por ';'). Vazio + DEBUG=True = localhost:3000-3002/5000-5002
CORS_ALLOWED_ORIGINS=
# Necessário p/ o Django Admin atrás de HTTPS, ex: https://api.datafood.com.br
CSRF_TRUSTED_ORIGINS=

DB_NAME=dtfd
DB_USER=dtfd
DB_PASS=dtfd
DB_HOST=db
DB_PORT=5432

REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/2

OLLAMA_URL=http://ollama:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# Token interno Django -> shinzou. Gere um aleatório em produção.
SHINZOU_SERVICE_TOKEN=dev-service-token
SHINZOU_URL=http://shinzou:8001

# JWT (minutos / dias) e rate limit da busca semântica
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
SEARCH_RATE=30/min

# Produção atrás de proxy TLS que já redireciona http->https: False
SECURE_SSL_REDIRECT=True
LOG_LEVEL=INFO
