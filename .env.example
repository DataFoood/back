# ---------------------------------------------------------------------------
# DataFood — variáveis de ambiente
# Dev: copie para .env e rode `docker compose up -d --build`.
# Produção: veja docs/deploy.md (DEBUG=False exige SECRET_KEY e
# SHINZOU_SERVICE_TOKEN fortes, senão a aplicação se recusa a subir).
# ---------------------------------------------------------------------------
DEBUG=True

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-troque-em-producao
# Separados por ';'
ALLOWED_HOSTS=localhost;127.0.0.1;web

# Origens do frontend (separadas por ';'). Vazio + DEBUG=True = localhost:3000-3002/5000-5002
CORS_ALLOWED_ORIGINS=
# Necessário p/ o Django Admin atrás de HTTPS, ex: https://api.datafood.com.br
CSRF_TRUSTED_ORIGINS=

DB_NAME=dtfd
DB_USER=dtfd
DB_PASS=dtfd
DB_HOST=db
DB_PORT=5432

REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/2

OLLAMA_URL=http://ollama:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# Token interno Django -> shinzou. Gere um aleatório em produção.
SHINZOU_SERVICE_TOKEN=dev-service-token
SHINZOU_URL=http://shinzou:8001

# JWT (minutos / dias) e rate limit da busca semântica
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
SEARCH_RATE=30/min
# Proxies confiáveis na frente da API: 0 em dev (acesso direto), 1 atrás do Caddy.
# Sem isso o X-Forwarded-For (forjável) viraria a identidade do rate limit.
NUM_PROXIES=0

# Produção atrás de proxy TLS que já redireciona http->https: False
SECURE_SSL_REDIRECT=True
LOG_LEVEL=INFO

# --- Promoções por mensageiros -------------------------------------------
# Links das mensagens (página do restaurante, descadastro) apontam pro front.
FRONTEND_URL=http://localhost:3000
# Telegram: crie o bot com o @BotFather e cole o token/username. Vazio =
# canal desligado. Funciona local (long polling, sem URL pública).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_POLL_SECONDS=10
# E-mail: console imprime no log do worker. Para enviar de verdade:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend + EMAIL_HOST...
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=DataFood <promocoes@datafood.local>
# Anti-spam: promoções por restaurante/dia e por pessoa/24h
PROMOTIONS_MAX_PER_DAY=3
PROMOTIONS_USER_DAILY_CAP=3
# Capacidade da máquina local (por dia) e custo/hora estimado de uma VPS (R$).
# Pico previsto do fim de semana >= 70% da capacidade -> painel sugere
# contratar infra de sexta 17h a domingo 23h (docs/weekend-infra.md).
LOCAL_CAPACITY_MESSAGES_PER_DAY=2000
LOCAL_CAPACITY_SEARCHES_PER_DAY=3000
WEEKEND_INFRA_HOURLY_COST=0.40

# --- Sessão do navegador (cookies HttpOnly) -------------------------------
# Secure padrão = not DEBUG (http://localhost em dev, HTTPS em produção).
# AUTH_COOKIE_SECURE=False
# AUTH_COOKIE_SAMESITE=Lax
# Vazio = cookie só do host da API (recomendado)
# AUTH_COOKIE_DOMAIN=
