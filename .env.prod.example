# Copie para .env.prod e preencha. NUNCA versione o .env.prod.
DEBUG=False
SECRET_KEY=

# Domínios públicos (DNS apontando pro servidor)
APP_DOMAIN=app.seudominio.com.br
API_DOMAIN=api.seudominio.com.br

ALLOWED_HOSTS=api.seudominio.com.br;web;localhost
CORS_ALLOWED_ORIGINS=https://app.seudominio.com.br
CSRF_TRUSTED_ORIGINS=https://api.seudominio.com.br

DB_NAME=dtfd
DB_USER=dtfd
DB_PASS=
DB_HOST=db
DB_PORT=5432

REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/2

OLLAMA_URL=http://ollama:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# Geocoding dos endereços de restaurante (Nominatim/OSM: máx 1 req/s;
# identifique a aplicação com um contato no User-Agent)
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=DataFood/0.1 (projeto academico)

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
SEARCH_RATE=30/min
# Proxies confiáveis na frente da API (Caddy = 1). Identifica o IP real no throttle.
NUM_PROXIES=1
SECURE_SSL_REDIRECT=True
LOG_LEVEL=INFO
WEB_WORKERS=3
